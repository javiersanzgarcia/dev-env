[appindicator]
legacy-tray-enabled=true
tray-pos='right'

[arcmenu]
arc-menu-icon=63
arcmenu-hotkey=['<Control>space']
custom-menu-button-text='Apps'
distro-icon=5
menu-button-appearance='Icon'
menu-button-icon='resource:///org/gnome/shell/extensions/arcmenu/icons/scalable/actions/distro-ubuntu-symbolic.svg'
menu-layout='Whisker'
menu-position-alignment=50
multi-monitor=true
pinned-apps=[{'id': 'firefox.desktop'}, {'id': 'org.gnome.Nautilus.desktop'}, {'id': 'gnome-extensions prefs arcmenu@arcmenu.com', 'name': 'ArcMenu Settings', 'icon': 'ArcMenu_ArcMenuIcon'}, {'id': 'ghostty_ghostty.desktop'}, {'id': 'brave-browser.desktop'}, {'id': 'org.gnome.Extensions.desktop'}, {'id': 'org.gnome.tweaks.desktop'}]
position-in-panel='Center'
prefs-visible-page=0
recently-installed-apps=['libreoffice_base.desktop', 'teams-for-linux_teams-for-linux.desktop', 'remote-viewer.desktop', 'windsurf.desktop', 'whatsapp-electron_whatsapp-electron.desktop', 'spotify_spotify.desktop', 'heroic.desktop', 'zutty.desktop', 'Dyson Sphere Program.desktop', 'discord_discord.desktop', 'whatsie_whatsie.desktop']
search-entry-border-radius=(true, 25)
update-notifier-project-version=71

[blur-my-shell]
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/panel]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[dash-to-dock]
apply-custom-theme=false
background-opacity=0.20000000000000001
dash-max-icon-size=38
dock-fixed=true
dock-position='BOTTOM'
height-fraction=0.90000000000000002
multi-monitor=false
preferred-monitor=-2
preferred-monitor-by-connector='DP-3'
running-indicator-style='DEFAULT'
show-favorites=true
show-show-apps-button=false
transparency-mode='FIXED'

[ding]
check-x11wayland=true
icon-size='tiny'
show-home=false
start-corner='top-right'

[focus-changer]
focus-down=['<Control><Super>Down']
focus-left=['<Control><Super>Left']
focus-right=['<Control><Super>Right']
focus-up=['<Control><Super>Up']

[tiling-assistant]
active-window-hint-color='rgb(211,70,21)'
enable-tiling-popup=false
last-version-installed=46
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
tiling-popup-all-workspace=true

[user-theme]
name='Dracula'

[vitals]
hot-sensors=['_storage_free_', '_processor_usage_', '_gpu#1_usage_', '_memory_available_']
icon-style=1
menu-centered=false
show-battery=false
show-gpu=true
update-time=5
