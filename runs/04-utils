#!/usr/bin/env bash
set -euo pipefail

sudo apt -y install bat btop
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

# install tldr, lsd and dust
curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
cargo install tldr lsd du-dust

# Install font

TEMP_DIR=$(mktemp -d)

wget -O "$TEMP_DIR/font.zip" "https://github.com/ryanoasis/nerd-fonts/releases/download/v2.3.0/CascadiaCode.zip"

unzip "$TEMP_DIR/font.zip" -d "$TEMP_DIR"

sudo mv "$TEMP_DIR"/*.otf /usr/local/share/fonts/

# Update the font cache
fc-cache -f -v

rm -rf "$TEMP_DIR"

