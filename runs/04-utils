#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
echo "[$SCRIPT_NAME] Starting..."

if ! command -v bat &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing bat..."
  sudo apt -y install bat
else
  echo "[$SCRIPT_NAME] bat already installed, skipping."
fi

if ! command -v btop &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing btop..."
  sudo apt -y install btop
else
  echo "[$SCRIPT_NAME] btop already installed, skipping."
fi

if ! command -v rustc &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Rust..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
else
  echo "[$SCRIPT_NAME] Rust already installed, skipping."
fi

if ! command -v go &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Go..."
  GO_VERSION=$(curl -s https://go.dev/VERSION?m=text | head -1)
  curl -fsSL "https://go.dev/dl/${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf /tmp/go.tar.gz
  rm /tmp/go.tar.gz
  export PATH="/usr/local/go/bin:$PATH"
else
  echo "[$SCRIPT_NAME] Go already installed, skipping."
fi

if ! command -v svn &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing SVN..."
  sudo apt-get install -y subversion
else
  echo "[$SCRIPT_NAME] SVN already installed, skipping."
fi

export PATH="/usr/local/go/bin:$HOME/.cargo/bin:$PATH"
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

if ! command -v tldr &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing tldr, lsd, dust..."
  curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
  cargo install tealdeer lsd du-dust
else
  echo "[$SCRIPT_NAME] tldr/lsd/dust already installed, skipping."
fi

if ! fc-list | grep -qi "cascadia"; then
  echo "[$SCRIPT_NAME] Installing Cascadia Code Nerd Font..."
  TEMP_DIR=$(mktemp -d)
  wget -O "$TEMP_DIR/font.zip" "https://github.com/ryanoasis/nerd-fonts/releases/download/v2.3.0/CascadiaCode.zip"
  unzip -o "$TEMP_DIR/font.zip" -d "$TEMP_DIR"
  sudo mv "$TEMP_DIR"/*.otf /usr/local/share/fonts/ 2>/dev/null || true
  fc-cache -f -v
  rm -rf "$TEMP_DIR"
else
  echo "[$SCRIPT_NAME] Cascadia fonts already installed, skipping."
fi

echo "[$SCRIPT_NAME] Done."

