#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Setting up wallpaper rotation"

chmod +x "$script_dir/env/wallpapers/rotate.sh"

mkdir -p ~/.config/systemd/user

cat > ~/.config/systemd/user/wallpaper-rotate.service << EOF
[Unit]
Description=Rotate wallpapers
After=default.target

[Service]
Type=simple
ExecStart=$script_dir/env/wallpapers/rotate.sh
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/$(id -u)
Restart=always
RestartSec=300

[Install]
WantedBy=default.target
EOF
systemctl --user daemon-reload
systemctl --user enable wallpaper-rotate.service
systemctl --user start wallpaper-rotate.service

echo "Wallpaper rotation service started"
