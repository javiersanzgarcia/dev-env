#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Check if already installed
if command -v windsurf &>/dev/null; then
    echo "[$SCRIPT_NAME] Windsurf already installed, skipping."
    exit 0
fi

echo "[$SCRIPT_NAME] Installing Windsurf..."
curl -fsSL "https://windsurf-stable.codeiumdata.com/wVxQEIWkwPUEAGf3/windsurf.gpg" | sudo gpg --dearmor -o /usr/share/keyrings/windsurf-stable-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/windsurf-stable-archive-keyring.gpg arch=amd64] https://windsurf-stable.codeiumdata.com/wVxQEIWkwPUEAGf3/apt stable main" | sudo tee /etc/apt/sources.list.d/windsurf.list >/dev/null
sudo apt-get update
sudo apt-get install -y windsurf

# Install extensions (errors are non-fatal)
install_ext() {
  windsurf --install-extension "$1" 2>/dev/null || echo "Failed to install $1, skipping"
}

