#!/usr/bin/env bash

echo "Installing Password Manager..."

# Bitwarden CLI
echo "Installing Bitwarden CLI..."
if ! command -v bw &> /dev/null; then
    curl -fsSL https://github.com/bitwarden/clients/releases/download/cli-v2024.3.0/bw-linux-x64-v2024.3.0.zip -o /tmp/bw.zip
    unzip -q /tmp/bw.zip -d /tmp
    sudo mv /tmp/bw /usr/local/bin/
    rm /tmp/bw.zip
    sudo chmod +x /usr/local/bin/bw
fi

# 1Password CLI (optional)
echo "Installing 1Password CLI..."
if ! command -v op &> /dev/null; then
    curl -fsSL https://cache.agilebits.com/dist/1P/op2/linux/stable/op_amd64 -o /tmp/op
    sudo mv /tmp/op /usr/local/bin/op
    sudo chmod +x /usr/local/bin/op
fi

# pass - Standard Unix password manager
echo "Installing pass..."
sudo apt -y install pass pass-extension-tail pass-extension-otp

# Add bash/zsh completion for bw
echo "Setting up Bitwarden CLI completion..."
bw completion --shell bash | sudo tee /etc/bash_completion.d/bw.bash > /dev/null 2>/dev/null || true

echo "Password managers installed:"
echo "  - Bitwarden CLI: bw"
echo "  - 1Password CLI: op"
echo "  - pass: pass"
echo ""
echo "To use Bitwarden: bw login, then bw unlock"