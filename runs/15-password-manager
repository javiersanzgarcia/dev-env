#!/usr/bin/env bash
set -euo pipefail

echo "Installing Password Manager..."

# Bitwarden CLI
echo "Installing Bitwarden CLI..."
if ! command -v bw &> /dev/null; then
    # Download from official site (works for both x64 and arm64)
    ARCH=$(uname -m)
    if [ "$ARCH" = "x86_64" ]; then
        curl -fsSL "https://vault.bitwarden.com/download/?app=cli&platform=linux" -o /tmp/bw.zip
    else
        curl -fsSL "https://vault.bitwarden.com/download/?app=cli&platform=linux&arch=arm64" -o /tmp/bw.zip
    fi
    if [ -f /tmp/bw.zip ]; then
        unzip -q /tmp/bw.zip -d /tmp
        sudo mv /tmp/bw /usr/local/bin/
        rm /tmp/bw.zip
        sudo chmod +x /usr/local/bin/bw
    else
        echo "Failed to download Bitwarden CLI"
    fi
fi

# 1Password CLI (optional)
echo "Installing 1Password CLI..."
if ! command -v op &> /dev/null; then
    # Add 1Password repository
    curl -sS https://downloads.1password.com/linux/keys/1password.asc | sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg 2>/dev/null || true
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(lsb_release -cs) stable main" | sudo tee /etc/apt/sources.list.d/1password.list > /dev/null 2>&1 || true
    sudo apt-get update 2>/dev/null || true
    sudo apt-get install -y 1password-cli 2>/dev/null || echo "Failed to install 1Password CLI via repository"
fi

# pass - Standard Unix password manager
echo "Installing pass..."
sudo apt -y install pass pass-extension-tail pass-extension-otp

# KeePassXC - GUI password manager with GNOME integration
echo "Installing KeePassXC..."
sudo apt -y install keepassxc

# Add bash/zsh completion for bw
echo "Setting up Bitwarden CLI completion..."
bw completion --shell bash | sudo tee /etc/bash_completion.d/bw.bash > /dev/null 2>/dev/null || true

echo "Password managers installed:"
echo "  - Bitwarden CLI: bw"
echo "  - 1Password CLI: op"
echo "  - pass: pass"
echo ""
echo "To use Bitwarden: bw login, then bw unlock"