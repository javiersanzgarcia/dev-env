#!/usr/bin/env bash
set -euo pipefail

echo "Installing DBeaver..."

# Option 1: Install via snap (recommended for Ubuntu)
if command -v snap &> /dev/null; then
    sudo snap install dbeaver-ce --classic
else
    # Option 2: Install via apt
    wget -O /tmp/dbeaver-ce-latest-stable.x86_64.zip https://dbeaver.io/files/dbeaver-ce-latest-stable.x86_64.zip
    unzip -o /tmp/dbeaver-ce-latest-stable.x86_64.zip -d /opt/
    sudo ln -sf /opt/dbeaver*/dbeaver /usr/local/bin/dbeaver
    rm /tmp/dbeaver-ce-latest-stable.x86_64.zip
fi

echo "Installing NoSQL clients..."

# MongoDB Compass (GUI for MongoDB)
if ! command -v mongodb-compass &> /dev/null; then
    wget -q https://downloads.mongodb.com/compass/mongodb-compass_1.44.8_amd64.deb -O /tmp/mongodb-compass.deb
    sudo dpkg -i /tmp/mongodb-compass.deb || sudo apt-get -f install -y
    rm /tmp/mongodb-compass.deb
fi

echo "Database clients installed:"
echo "  - DBeaver: dbeaver"
echo "  - MongoDB Compass: mongodb-compass"
