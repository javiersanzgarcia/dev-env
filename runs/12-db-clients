#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Check if DBeaver already installed
if command -v dbeaver &> /dev/null; then
    echo "[$SCRIPT_NAME] DBeaver already installed, skipping."
else
    echo "[$SCRIPT_NAME] Installing DBeaver..."

    # Option1: Install via snap (recommended for Ubuntu)
    if command -v snap &> /dev/null; then
        sudo snap install dbeaver-ce --classic
    else
        # Option 2: Install via GitHub releases
        DBEAVER_VERSION=$(curl -s "https://api.github.com/repos/dbeaver/dbeaver/releases/latest" | grep -Po '"tag_name":\s*"\K[^"]*')
        if [ -z "$DBEAVER_VERSION" ]; then
            echo "[$SCRIPT_NAME] Failed to get DBeaver version"
            exit 1
        fi
        ARCH=$(uname -m)
        if [ "$ARCH" = "x86_64" ]; then
            wget -O /tmp/dbeaver-ce.tar.gz "https://github.com/dbeaver/dbeaver/releases/download/$DBEAVER_VERSION/dbeaver-ce-$DBEAVER_VERSION-linux-x86_64.tar.gz"
            sudo tar -xzf /tmp/dbeaver-ce.tar.gz -C /opt/
            sudo ln -sf /opt/dbeaver*/dbeaver /usr/local/bin/dbeaver
            # Create desktop entry for GNOME
            if [ -f /opt/dbeaver/dbeaver-ce.desktop ]; then
                sudo cp /opt/dbeaver/dbeaver-ce.desktop /usr/share/applications/
                sudo sed -i 's|/usr/share/dbeaver-ce/|/opt/dbeaver/|g' /usr/share/applications/dbeaver-ce.desktop
            fi
            rm /tmp/dbeaver-ce.tar.gz
        else
            echo "[$SCRIPT_NAME] Unsupported architecture: $ARCH"
            exit 1
        fi
    fi
fi
    ARCH=$(uname -m)
    if [ "$ARCH" = "x86_64" ]; then
        wget -O /tmp/dbeaver-ce.tar.gz "https://github.com/dbeaver/dbeaver/releases/download/$DBEAVER_VERSION/dbeaver-ce-$DBEAVER_VERSION-linux-x86_64.tar.gz"
        sudo tar -xzf /tmp/dbeaver-ce.tar.gz -C /opt/
        sudo ln -sf /opt/dbeaver*/dbeaver /usr/local/bin/dbeaver
        # Create desktop entry for GNOME
        if [ -f /opt/dbeaver/dbeaver-ce.desktop ]; then
            sudo cp /opt/dbeaver/dbeaver-ce.desktop /usr/share/applications/
            sudo sed -i 's|/usr/share/dbeaver-ce/|/opt/dbeaver/|g' /usr/share/applications/dbeaver-ce.desktop
        fi
        rm /tmp/dbeaver-ce.tar.gz
    else
        echo "Unsupported architecture: $ARCH"
        exit 1
    fi
fi

echo "Installing NoSQL clients..."

# MongoDB Compass (GUI for MongoDB)
if ! command -v mongodb-compass &> /dev/null; then
    echo "Installing MongoDB Compass..."
    wget -q "https://downloads.mongodb.com/compass/mongodb-compass_1.45.0_amd64.deb" -O /tmp/mongodb-compass.deb || echo "Failed to download MongoDB Compass"
    if [ -f /tmp/mongodb-compass.deb ]; then
        sudo dpkg -i /tmp/mongodb-compass.deb || sudo apt-get -f install -y
        rm -f /tmp/mongodb-compass.deb
        echo "MongoDB Compass installed."
    fi
else
    echo "MongoDB Compass already installed, skipping."
fi

echo "Database clients installed:"
echo "  - DBeaver: dbeaver"
echo "  - MongoDB Compass: mongodb-compass"
