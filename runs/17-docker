#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
echo "[$SCRIPT_NAME] Starting..."

# Check if already installed
if command -v docker &>/dev/null && systemctl --user is-active --quiet docker-desktop 2>/dev/null; then
  echo "[$SCRIPT_NAME] Docker Desktop already installed and running, skipping."
  exit 0
fi

echo "[$SCRIPT_NAME] Installing Docker Desktop..."

# Install dependencies (non-interactive)
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y -qq ca-certificates curl gnupg lsb-release qemu-kvm libvirt-daemon-system libvirt-clients virtinst

# Get latest Docker Desktop version
DOCKER_DESKTOP_VERSION=$(curl -s "https://api.github.com/repos/docker/desktop/releases/latest" | grep -oP '"tag_name":\s*"\K[^"]*' | sed 's/^v//')
if [ -z "$DOCKER_DESKTOP_VERSION" ]; then
  echo "[$SCRIPT_NAME] Failed to get latest version, using fallback 4.41.2"
  DOCKER_DESKTOP_VERSION="4.41.2"
fi

# Download Docker Desktop
DOCKER_DESKTOP_URL="https://desktop.docker.com/linux/main/amd64/docker-desktop-${DOCKER_DESKTOP_VERSION}-amd64.deb"
echo "[$SCRIPT_NAME] Downloading from: $DOCKER_DESKTOP_URL"
wget -q "$DOCKER_DESKTOP_URL" -O /tmp/docker-desktop.deb || {
  echo "[$SCRIPT_NAME] Failed to download Docker Desktop"
  exit 1
}

# Install Docker Desktop
sudo dpkg -i /tmp/docker-desktop.deb || sudo apt-get -f install -y
rm -f /tmp/docker-desktop.deb

# Create desktop entry if not exists
if [ ! -f /usr/share/applications/docker-desktop.desktop ] && [ -f /opt/docker-desktop/docker-desktop ]; then
  sudo bash -c 'cat > /usr/share/applications/docker-desktop.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Docker Desktop
GenericName=Container Platform
Comment=Docker Desktop - Build, Share, and Run Containers
Exec=/opt/docker-desktop/bin/docker-desktop
Icon=/opt/docker-desktop/resources/docker-desktop-logo.png
Categories=Development;
StartupWMClass=Docker Desktop
StartupNotify=true
EOF'
fi

echo "[$SCRIPT_NAME] Done. Run 'systemctl --user start docker-desktop' to start Docker Desktop."
