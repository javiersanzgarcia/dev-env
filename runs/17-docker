#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
echo "[$SCRIPT_NAME] Starting..."

# Check if already installed
if [ -f /opt/docker-desktop/bin/docker-desktop ] && systemctl --user is-active --quiet docker-desktop 2>/dev/null; then
  echo "[$SCRIPT_NAME] Docker Desktop already installed and running, skipping."
  exit 0
elif [ -f /opt/docker-desktop/bin/docker-desktop ]; then
  echo "[$SCRIPT_NAME] Docker Desktop already installed, skipping."
  exit 0
fi

echo "[$SCRIPT_NAME] Installing Docker Desktop following official instructions..."

# Install dependencies (non-interactive)
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y -qq ca-certificates curl gnupg lsb-release qemu-kvm libvirt-daemon-system libvirt-clients virtinst gnome-terminal

# Step 1: Set up Docker's apt repository (as per official docs)
echo "[$SCRIPT_NAME] Setting up Docker's apt repository..."
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
sudo apt-get update -qq

# Step 2: Download Docker Desktop DEB package (using link from official docs)
DOCKER_DESKTOP_URL="https://desktop.docker.com/linux/main/amd64/docker-desktop-amd64.deb"
echo "[$SCRIPT_NAME] Downloading Docker Desktop from $DOCKER_DESKTOP_URL..."
curl -L -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" -o /tmp/docker-desktop.deb "$DOCKER_DESKTOP_URL" || {
  echo "[$SCRIPT_NAME] Failed to download Docker Desktop. Please download manually from:"
  echo "[$SCRIPT_NAME] $DOCKER_DESKTOP_URL"
  echo "[$SCRIPT_NAME] Then install with: sudo apt-get install ./docker-desktop-amd64.deb"
  exit 1
}

# Step 3: Install the package
echo "[$SCRIPT_NAME] Installing Docker Desktop..."
sudo apt-get install -y /tmp/docker-desktop.deb || sudo dpkg -i /tmp/docker-desktop.deb && sudo apt-get -f install -y
rm -f /tmp/docker-desktop.deb

# Create desktop entry if not exists
if [ ! -f /usr/share/applications/docker-desktop.desktop ] && [ -f /opt/docker-desktop/bin/docker-desktop ]; then
  echo "[$SCRIPT_NAME] Creating desktop entry..."
  sudo bash -c 'cat > /usr/share/applications/docker-desktop.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Docker Desktop
GenericName=Container Platform
Comment=Docker Desktop - Build, Share, and Run Containers
Exec=/opt/docker-desktop/bin/docker-desktop
Icon=/opt/docker-desktop/resources/docker-desktop-logo.png
Categories=Development;
StartupWMClass=Docker Desktop
StartupNotify=true
EOF'
fi

# Add user to docker group
sudo usermod -aG docker "${USER}" 2>/dev/null || true

echo "[$SCRIPT_NAME] Docker Desktop installed successfully."
echo "[$SCRIPT_NAME] Start with: systemctl --user start docker-desktop"
echo "[$SCRIPT_NAME] Or launch from your applications menu."
