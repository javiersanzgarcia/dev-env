#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Check if already installed
if command -v idea &> /dev/null; then
    echo "[$SCRIPT_NAME] IntelliJ already installed, skipping."
    exit 0
fi

echo "[$SCRIPT_NAME] Installing IntelliJ Community Edition"

if command -v snap &> /dev/null; then
  echo "[$SCRIPT_NAME] Installing via snap..."
  sudo snap install intellij-idea-community --classic
else
  echo "[$SCRIPT_NAME] Snap not found, installing via tarball..."

  latest_json=$(curl -s "https://data.services.jetbrains.com/products/releases?code=IIC&latest=true&type=release")
  download_link=$(echo "$latest_json" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data['IIC'][0]['downloads']['linux']['link'])" 2>/dev/null)

  if [ -z "$download_link" ]; then
    echo "[$SCRIPT_NAME] Failed to get download link"
    exit 1
  fi

  temp_dir=$(mktemp -d)
  echo "[$SCRIPT_NAME] Downloading: $download_link"
  wget -O "$temp_dir/ideaIC.tar.gz" "$download_link"

  echo "[$SCRIPT_NAME] Extracting to /opt/..."
  sudo tar -xzf "$temp_dir/ideaIC.tar.gz" -C /opt/
  rm -rf "$temp_dir"

  idea_dir=$(ls /opt/ | grep idea-IC | head -1)
  sudo ln -sf "/opt/$idea_dir/bin/idea.sh" /usr/local/bin/idea
  # Create desktop entry for GNOME
  sudo bash -c "cat > /usr/share/applications/intellij-idea-ce.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=IntelliJ IDEA Community Edition
GenericName=Java IDE
Comment=IntelliJ IDEA Community Edition IDE
Exec=/opt/$idea_dir/bin/idea.sh
Icon=/opt/$idea_dir/bin/idea.svg
Categories=Development;IDE;
StartupWMClass=jetbrains-idea-ce
StartupNotify=true
Keywords=Java;IDE;Development;
EOF"
fi

echo "IntelliJ Community installed. Run with: idea"
