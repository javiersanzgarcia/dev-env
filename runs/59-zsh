#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Check if zsh is already installed and configured
if command -v zsh &> /dev/null && [ -d "$HOME/.oh-my-zsh" ] && [ -f "$HOME/.zshrc" ]; then
    echo "[$SCRIPT_NAME] zsh already installed and configured, skipping."
    exit 0
fi

echo "[$SCRIPT_NAME] Installing zsh..."
sudo apt -y install zsh fonts-powerline

hash -r
chsh -s "$(which zsh)" 2>/dev/null || true

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo "[$SCRIPT_NAME] Installing Oh My Zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "[$SCRIPT_NAME] Oh My Zsh already installed, skipping"
fi

if [ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]; then
  echo "[$SCRIPT_NAME] Installing powerlevel10k..."
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
else
  echo "[$SCRIPT_NAME] powerlevel10k already installed, skipping"
fi

if [ -d "$script_dir/env/.oh-my-zsh" ]; then
  ln -nf "$script_dir/env/.oh-my-zsh" ~/
fi
ln -nf "$script_dir/env/clean.sh" ~/
ln -nf "$script_dir/env/keyboard_permissions.sh" ~/
ln -nf "$script_dir/env/mount.sh" ~/
ln -nf "$script_dir/env/.zshrc" ~/
ln -nf "$script_dir/env/.p10k.zsh" ~/

if [ ! -d "$HOME/.oh-my-zsh/custom/plugins/fast-syntax-highlighting" ]; then
  echo "[$SCRIPT_NAME] Installing fast-syntax-highlighting..."
  git clone https://github.com/zdharma-continuum/fast-syntax-highlighting ~/.oh-my-zsh/custom/plugins/fast-syntax-highlighting
else
  echo "[$SCRIPT_NAME] fast-syntax-highlighting already installed, skipping"
fi

if [ ! -d "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions" ]; then
  echo "[$SCRIPT_NAME] Installing zsh-autosuggestions..."
  git clone https://github.com/zsh-users/zsh-autosuggestions.git ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
else
  echo "[$SCRIPT_NAME] zsh-autosuggestions already installed, skipping"
fi

echo "[$SCRIPT_NAME] zsh setup complete. Restart your terminal or run: exec zsh"
