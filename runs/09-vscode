#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Check if already installed
if command -v code &>/dev/null; then
    echo "[$SCRIPT_NAME] VSCode already installed, skipping."
    exit 0
fi

echo "[$SCRIPT_NAME] Installing VSCode..."
sudo apt-get install -y wget gpg
wget -qO- https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor -o /usr/share/keyrings/packages.microsoft.gpg
sudo sh -c 'echo "deb [signed-by=/usr/share/keyrings/packages.microsoft.gpg arch=amd64] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list'
sudo apt-get update
sudo apt-get install -y code
