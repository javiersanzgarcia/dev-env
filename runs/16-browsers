#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
echo "[$SCRIPT_NAME] Starting..."

# Firefox
if ! command -v firefox &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Firefox..."
  sudo apt -y install firefox
else
  echo "[$SCRIPT_NAME] Firefox already installed, skipping."
fi

# Chromium
if ! command -v chromium &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Chromium..."
  if grep -q "Ubuntu" /etc/os-release 2>/dev/null; then
    sudo apt -y install chromium-browser
  else
    sudo apt -y install chromium
  fi
else
  echo "[$SCRIPT_NAME] Chromium already installed, skipping."
fi

# Google Chrome
if ! command -v google-chrome &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Google Chrome..."
  wget -q "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb" -O /tmp/chrome.deb
  sudo dpkg -i /tmp/chrome.deb || sudo apt-get -f install -y
  rm /tmp/chrome.deb
else
  echo "[$SCRIPT_NAME] Chrome already installed, skipping."
fi

# Brave
if ! command -v brave-browser &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Brave..."
  sudo apt-get install -y apt-transport-https curl
  sudo curl -fsSL https://brave-browser-apt-release.s3.brave.com/brave-core.asc | sudo gpg --dearmor -o /usr/share/keyrings/brave-browser-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" | sudo tee /etc/apt/sources.list.d/brave-browser.list
  sudo apt-get update || true
  sudo apt-get install -y brave-browser
else
  echo "[$SCRIPT_NAME] Brave already installed, skipping."
fi

# Waterfox
if ! command -v waterfox &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Waterfox..."
  WATERFOX_VERSION=$(curl -s "https://api.github.com/repos/BrowserWorks/Waterfox/releases/latest" | grep -oP '"tag_name":\s*"\K[^"]*')
  if [ -z "$WATERFOX_VERSION" ]; then
    echo "Failed to get Waterfox version"
  else
    wget -q "https://cdn1.waterfox.net/waterfox/releases/${WATERFOX_VERSION}/Linux_x86_64/waterfox-${WATERFOX_VERSION}.tar.bz2" -O /tmp/waterfox.tar.bz2 || echo "Failed to download Waterfox"
  if [ -f /tmp/waterfox.tar.bz2 ]; then
      sudo tar -xjf /tmp/waterfox.tar.bz2 -C /opt/
      sudo ln -sf /opt/waterfox/waterfox /usr/local/bin/waterfox
      # Create desktop entry
      sudo bash -c 'cat > /usr/share/applications/waterfox.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Waterfox
GenericName=Web Browser
Comment=Waterfox Web Browser
Exec=/opt/waterfox/waterfox %u
Icon=/opt/waterfox/browser/chrome/icons/default/default128.png
Categories=Network;WebBrowser;
StartupWMClass=Waterfox
StartupNotify=true
EOF'
      rm /tmp/waterfox.tar.bz2
  fi
  fi
else
  echo "[$SCRIPT_NAME] Waterfox already installed, skipping."
fi

# Vivaldi
if ! command -v vivaldi &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Vivaldi..."
  # Get download URL from vivaldi.com
  VIVALDI_URL=$(curl -s "https://vivaldi.com/download/" | grep -oP 'href="\Khttps://downloads\.vivaldi\.com/stable/vivaldi-stable[^"]+amd64\.deb' | head -1)
  if [ -z "$VIVALDI_URL" ]; then
    # Fallback to known version
    VIVALDI_URL="https://downloads.vivaldi.com/stable/vivaldi-stable_7.9.3970.60-1_amd64.deb"
  fi
  wget -q "$VIVALDI_URL" -O /tmp/vivaldi.deb || echo "Failed to download Vivaldi"
  if [ -f /tmp/vivaldi.deb ]; then
    sudo dpkg -i /tmp/vivaldi.deb || sudo apt-get -f install -y
    rm /tmp/vivaldi.deb
  fi
else
  echo "[$SCRIPT_NAME] Vivaldi already installed, skipping."
fi
  wget -q "https://downloads.vivaldi.com/stable/vivaldi-stable_${VIVALDI_VERSION}_amd64.deb" -O /tmp/vivaldi.deb || echo "Failed to download Vivaldi"
  if [ -f /tmp/vivaldi.deb ]; then
    sudo dpkg -i /tmp/vivaldi.deb || sudo apt-get -f install -y
    rm /tmp/vivaldi.deb
  fi
else
  echo "[$SCRIPT_NAME] Vivaldi already installed, skipping."
fi

# Helium
if ! command -v helium &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Helium..."
  HELIUM_VERSION=$(curl -s "https://api.github.com/repos/imputnet/helium-linux/releases/latest" | grep -Po '"tag_name":\s*"\K[^"]*')
  if [ -z "$HELIUM_VERSION" ]; then
    echo "Failed to get Helium version"
  else
    HELIUM_DEB="helium-bin_${HELIUM_VERSION#v}-1_amd64.deb"
    HELIUM_URL="https://github.com/imputnet/helium-linux/releases/download/${HELIUM_VERSION}/${HELIUM_DEB}"
    wget -q "$HELIUM_URL" -O /tmp/helium.deb || echo "Failed to download Helium"
    if [ -f /tmp/helium.deb ]; then
      sudo dpkg -i /tmp/helium.deb || sudo apt-get -f install -y
      # Create desktop entry for Helium
      if [ -f /usr/share/applications/helium.desktop ]; then
        sudo cp /usr/share/applications/helium.desktop /usr/share/applications/helium.desktop 2>/dev/null || true
      fi
      rm /tmp/helium.deb
    fi
  fi
else
  echo "[$SCRIPT_NAME] Helium already installed, skipping."
fi

echo ""
echo "[$SCRIPT_NAME] All browsers installed:"
echo "  - Firefox: firefox"
echo "  - Chromium: chromium"
echo "  - Chrome: google-chrome"
echo "  - Brave: brave-browser"
echo "  - Waterfox: waterfox"
echo "  - Vivaldi: vivaldi"
echo "  - Helium: helium"
echo "[$SCRIPT_NAME] Done."