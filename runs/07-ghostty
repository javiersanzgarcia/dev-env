#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
echo "[$SCRIPT_NAME] Starting..."

if ! command -v ghostty &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Ghostty..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"
else
  echo "[$SCRIPT_NAME] Ghostty already installed, skipping."
fi

if ! command -v warp &>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Warp terminal..."
  WARP_VERSION=$(curl -s "https://api.github.com/repos/warpdotdev/warp/releases/latest" | grep -Po '"tag_name":\s*"\K[^"]*')
  WARP_URL="https://github.com/warpdotdev/warp/releases/download/${WARP_VERSION}/warp_${WARP_VERSION}_amd64.deb"
  wget -q "$WARP_URL" -O /tmp/warp.deb
  sudo apt install -y /tmp/warp.deb
  rm -f /tmp/warp.deb
  echo "[$SCRIPT_NAME] Warp installed."
else
  echo "[$SCRIPT_NAME] Warp already installed, skipping."
fi

echo "[$SCRIPT_NAME] Done."
