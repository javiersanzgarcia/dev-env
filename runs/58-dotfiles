#!/usr/bin/env bash
set -euo pipefail

echo "Linking dotfiles"
pwd

cd env/dotfiles || exit 1
for i in *; do
    if [ -d "$i" ]; then
        echo "Stowing $i"
        # Remove existing config dirs to avoid stow conflicts
        rm -fr "$HOME"/.config/$i
        # For Code, clean User dir which may have VSCode-generated files
        if [ "$i" = "Code" ]; then
            rm -fr "$HOME"/.config/Code/User
            # Remove any VSCode-generated files that might conflict with stow
            rm -f "$HOME"/.config/Code/User/chatLanguageModels.json
            rm -f "$HOME"/.config/Code/User/mcp.json
            rm -rf "$HOME"/.config/Code/User/sync
            # Don't remove globalStorage - let stow handle the symlinks
            # rm -rf "$HOME"/.config/Code/User/globalStorage
            # Backup state.vscdb before stow (state.vscdb is not versionable)
            if [ -f "$HOME/.config/Code/User/globalStorage/state.vscdb" ]; then
                cp "$HOME/.config/Code/User/globalStorage/state.vscdb" \
                   "$HOME/.config/Code/User/globalStorage/state.vscdb.backup"
            fi
            # Backup extensions list
            if command -v code &> /dev/null; then
                code --list-extensions > "$HOME/.config/Code/User/globalStorage/extensions-backup.txt"
            fi
            rm -rf "$HOME"/.config/Code/User/History
            rm -rf "$HOME"/.config/Code/User/workspaceStorage
            rm -rf "$HOME"/.config/Code/User/snippets
        fi
stow --restow --target=$HOME $i
        # Remove state.vscdb symlink and restore local version
        if [ "$i" = "Code" ]; then
            if [ -L "$HOME/.config/Code/User/globalStorage/state.vscdb" ]; then
                rm -f "$HOME/.config/Code/User/globalStorage/state.vscdb"
                if [ -f "$HOME/.config/Code/User/globalStorage/state.vscdb.backup" ]; then
                    cp "$HOME/.config/Code/User/globalStorage/state.vscdb.backup" \
                       "$HOME/.config/Code/User/globalStorage/state.vscdb"
                fi
            fi
        fi
    fi
 done

cd ../.. || exit 1

echo "Stowing dotfiles"

rm -rf "$HOME"/personal/nvim
git clone https://github.com/javiersanzgarcia/LazyVIM.git "$HOME"/personal/nvim

cp -r "$HOME"/personal/nvim "$HOME"/.config
chmod -R 777 "$HOME"/.config/nvim
rm -rf "$HOME"/personal
