#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Check mode: only verify installed programs
if [ "${1:-}" = "--check" ] || [ "${1:-}" = "--safe" ]; then
  echo "[$SCRIPT_NAME] Check mode: verifying installed programs..."
  declare -A programs=(
    ["calibre"]="calibre"
    ["telegram-desktop"]="telegram-desktop"
    ["spotify"]="spotify-client"
    ["whatsie"]="whatsie"
    ["vial"]="vial"
  )
  for cmd in "${!programs[@]}"; do
    pkg="${programs[$cmd]}"
    if command -v $cmd &>/dev/null || dpkg -l | grep -q "$pkg" 2>/dev/null; then
      echo "  ✓ $cmd: installed"
    else
      echo "  ✗ $cmd: NOT installed"
    fi
  done
  exit 0
fi

echo "[$SCRIPT_NAME] Starting..."

# Ensure Archivo partition is mounted
ARCHIVO_MOUNT="/media/packer/Archivo"
if [ ! -d "$ARCHIVO_MOUNT" ] || [ ! -w "$ARCHIVO_MOUNT" ]; then
  echo "[$SCRIPT_NAME] Mounting Archivo partition..."
  sudo mkdir -p "$ARCHIVO_MOUNT"
  sudo mount -o uid=1000,gid=1000,umask=0000 -t exfat UUID="4870-BE1C" "$ARCHIVO_MOUNT" 2>/dev/null || true
fi

# Calibre - E-book manager
if ! command -v calibre &>/dev/null && ! dpkg -l | grep -q calibre; then
  echo "[$SCRIPT_NAME] Installing Calibre..."
  sudo apt-get install -y -qq calibre
else
  echo "[$SCRIPT_NAME] Calibre already installed, skipping."
fi

CALIBRE_LIBRARY="/media/packer/Archivo/Biblioteca"
if [ -d "$CALIBRE_LIBRARY" ] && [ -f "$CALIBRE_LIBRARY/metadata.db" ]; then
  echo "[$SCRIPT_NAME] Calibre library found at $CALIBRE_LIBRARY"
  mkdir -p ~/.config/calibre
  if [ ! -L ~/.config/calibre/library ] && [ ! -d ~/.config/calibre/library ]; then
    ln -sf "$CALIBRE_LIBRARY" ~/.config/calibre/library
  fi
  echo "[$SCRIPT_NAME] Calibre configured to use: $CALIBRE_LIBRARY"
fi

# Telegram Desktop
if ! command -v telegram-desktop &>/dev/null && ! dpkg -l | grep -q telegram-desktop; then
  echo "[$SCRIPT_NAME] Installing Telegram..."
  sudo apt-get update -qq
  # Try flatpak first (works on both Debian/Ubuntu)
  if command -v flatpak &>/dev/null; then
    flatpak install -y flathub org.telegram.desktop 2>/dev/null || echo "[$SCRIPT_NAME] Failed to install Telegram via flatpak."
  else
    # Try apt as fallback
    if sudo apt-get install -y telegram-desktop 2>/dev/null; then
      echo "[$SCRIPT_NAME] Telegram installed via apt."
    else
      echo "[$SCRIPT_NAME] Failed to install Telegram. Install flatpak or enable non-free repos."
    fi
  fi
  # Create desktop entry if not auto-created
  if [ ! -f /usr/share/applications/telegram.desktop ] && [ -f /usr/bin/telegram-desktop ]; then
    sudo bash -c 'cat > /usr/share/applications/telegram.desktop << EOF'
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Telegram
GenericName=Messaging App
Comment=Telegram Desktop Client
Exec=/usr/bin/telegram-desktop --autostart
Icon=telegram
Categories=Network;InstantMessaging;
StartupWMClass=Telegram
StartupNotify=true
EOF'
  fi
else
  echo "[$SCRIPT_NAME] Telegram already installed, skipping."
fi

# Spotify
if ! command -v spotify &>/dev/null && ! dpkg -l | grep -q spotify-client; then
  echo "[$SCRIPT_NAME] Installing Spotify..."
  curl -sS https://download.spotify.com/debian/pubkey_7A3AE62FAFD4A51F.gpg | sudo gpg --dearmor -o /usr/share/keyrings/spotify.gpg
  echo "deb [signed-by=/usr/share/keyrings/spotify.gpg] https://repository.spotify.com stable non-free" | sudo tee /etc/apt/sources.list.d/spotify.list
  sudo apt-get update -qq
  sudo apt-get install -y spotify-client
  # Create desktop entry if not auto-created
  if [ ! -f /usr/share/applications/spotify.desktop ] && [ -f /usr/bin/spotify ]; then
    sudo bash -c 'cat > /usr/share/applications/spotify.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Spotify
GenericName=Music Player
Comment=Spotify Music Player
Exec=/usr/bin/spotify %U
Icon=spotify-client
Categories=Audio;Music;Player;
StartupWMClass=Spotify
StartupNotify=true
EOF'
  fi
else
  echo "[$SCRIPT_NAME] Spotify already installed, skipping."
fi

# Whatsie - WhatsApp desktop client
if ! command -v whatsie &>/dev/null && ! dpkg -l | grep -q whatsie; then
  echo "[$SCRIPT_NAME] Installing Whatsie..."
  WHATSIE_VERSION=$(curl -s "https://api.github.com/repos/whatsie/whatsie/releases/latest" | grep -oP '"tag_name":\s*"v\K[^"]*')
  if [ -z "$WHATSIE_VERSION" ]; then
    echo "[$SCRIPT_NAME] Failed to get Whatsie version"
  else
    curl -Lo /tmp/whatsie.deb "https://github.com/whatsie/whatsie/releases/download/v${WHATSIE_VERSION}/whatsie_${WHATSIE_VERSION}_linux_amd64.deb"
    sudo apt-get install -y /tmp/whatsie.deb
    rm -f /tmp/whatsie.deb
    # Create desktop entry
    if [ ! -f /usr/share/applications/whatsie.desktop ] && [ -f /usr/bin/whatsie ]; then
      sudo bash -c 'cat > /usr/share/applications/whatsie.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Whatsie
GenericName=WhatsApp Desktop Client
Comment=WhatsApp Web Desktop Client
Exec=/usr/bin/whatsie
Icon=whatsie
Categories=Network;InstantMessaging;
StartupWMClass=Whatsie
StartupNotify=true
EOF'
    fi
  fi
else
  echo "[$SCRIPT_NAME] Whatsie already installed, skipping."
fi

# Vial - Keyboard configurator for QMK
if ! command -v vial &>/dev/null && ! dpkg -l | grep -q vial; then
  echo "[$SCRIPT_NAME] Installing Vial..."
  VIAL_VERSION=$(curl -s "https://api.github.com/repos/vial-kb/vial-gui/releases/latest" | grep -oP '"tag_name":\s*"\K[^"]*')
  if [ -z "$VIAL_VERSION" ]; then
    echo "[$SCRIPT_NAME] Failed to get Vial version"
  else
    VIAL_URL="https://github.com/vial-kb/vial-gui/releases/download/${VIAL_VERSION}/Vial-${VIAL_VERSION}-x86_64.AppImage"
    wget -q "$VIAL_URL" -O /tmp/vial.AppImage || echo "[$SCRIPT_NAME] Failed to download Vial"
    if [ -f /tmp/vial.AppImage ]; then
      chmod +x /tmp/vial.AppImage
      sudo mv /tmp/vial.AppImage /usr/local/bin/vial
      # Create desktop entry
      sudo bash -c 'cat > /usr/share/applications/vial.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Vial
GenericName=Keyboard Configurator
Comment=QMK Keyboard Configurator
Exec=/usr/local/bin/vial
Icon=vial
Categories=Utility;
StartupWMClass=Vial
StartupNotify=true
EOF'
    fi
  fi
else
  echo "[$SCRIPT_NAME] Vial already installed, skipping."
fi

echo "[$SCRIPT_NAME] All extra applications installed."
