#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Check mode: only verify installed programs
if [ "${1:-}" = "--check" ] || [ "${1:-}" = "--safe" ]; then
  echo "[$SCRIPT_NAME] Check mode: verifying installed programs..."
  declare -A programs=(
    ["calibre"]="calibre"
    ["telegram-desktop"]="telegram-desktop"
    ["spotify"]="spotify-client"
    ["whatsie"]="whatsie"
    ["vial"]="vial"
  )
  for cmd in "${!programs[@]}"; do
    pkg="${programs[$cmd]}"
    if command -v $cmd &>/dev/null || dpkg -l | grep -q "$pkg" 2>/dev/null; then
      echo "  ✓ $cmd: installed"
    else
      echo "  ✗ $cmd: NOT installed"
    fi
  done
  exit 0
fi

echo "[$SCRIPT_NAME] Starting..."

# Ensure Archivo partition is mounted
ARCHIVO_MOUNT="/media/pracker/Archivo"
if [ ! -d "$ARCHIVO_MOUNT" ] || [ ! -w "$ARCHIVO_MOUNT" ]; then
  echo "[$SCRIPT_NAME] Mounting Archivo partition..."
  sudo mkdir -p "$ARCHIVO_MOUNT"
  sudo mount -o uid=1000,gid=1000,umask=0000 -t exfat UUID="4870-BE1C" "$ARCHIVO_MOUNT" 2>/dev/null || true
fi

# Calibre - E-book manager
if ! command -v calibre &>/dev/null && ! dpkg -l | grep -q calibre; then
  echo "[$SCRIPT_NAME] Installing Calibre..."
  sudo apt-get install -y -qq calibre
else
  echo "[$SCRIPT_NAME] Calibre already installed, skipping."
fi

CALIBRE_LIBRARY="/media/pracker/Archivo/Biblioteca"
if [ -d "$CALIBRE_LIBRARY" ] && [ -f "$CALIBRE_LIBRARY/metadata.db" ]; then
  echo "[$SCRIPT_NAME] Calibre library found at $CALIBRE_LIBRARY"
  mkdir -p ~/.config/calibre
  if [ ! -L ~/.config/calibre/library ] && [ ! -d ~/.config/calibre/library ]; then
    ln -sf "$CALIBRE_LIBRARY" ~/.config/calibre/library
  fi
  echo "[$SCRIPT_NAME] Calibre configured to use: $CALIBRE_LIBRARY"
fi

# Telegram Desktop (using flatpak)
if ! command -v telegram-desktop &>/dev/null && ! dpkg -l | grep -q telegram-desktop && ! flatpak list | grep -q org.telegram.desktop 2>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Telegram..."
  if command -v flatpak &>/dev/null; then
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
    flatpak install -y flathub org.telegram.desktop 2>/dev/null || echo "[$SCRIPT_NAME] Failed to install Telegram via flatpak."
  else
    echo "[$SCRIPT_NAME] Flatpak not found. Install flatpak first: sudo apt install flatpak"
  fi
else
  echo "[$SCRIPT_NAME] Telegram already installed, skipping."
fi

# Spotify
if ! command -v spotify &>/dev/null && ! dpkg -l | grep -q spotify-client; then
  echo "[$SCRIPT_NAME] Installing Spotify..."
  # Download and convert GPG key properly
  sudo rm -f /usr/share/keyrings/spotify.gpg
  curl -sS https://download.spotify.com/debian/pubkey_5384CE82BA52C83A.asc | sudo gpg --dearmor -o /usr/share/keyrings/spotify.gpg || {
    echo "[$SCRIPT_NAME] Failed to download Spotify GPG key"
    exit 1
  }
  echo "deb [signed-by=/usr/share/keyrings/spotify.gpg] https://repository.spotify.com stable non-free" | sudo tee /etc/apt/sources.list.d/spotify.list > /dev/null
  sudo apt-get update -qq
  sudo apt-get install -y spotify-client
else
  echo "[$SCRIPT_NAME] Spotify already installed, skipping."
fi

# Whatsie - WhatsApp desktop client (using flatpak)
if ! command -v whatsie &>/dev/null && ! flatpak list | grep -q com.ktechpit.whatsie 2>/dev/null; then
  echo "[$SCRIPT_NAME] Installing Whatsie..."
  if command -v flatpak &>/dev/null; then
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
    flatpak install -y flathub com.ktechpit.whatsie 2>/dev/null || echo "[$SCRIPT_NAME] Failed to install Whatsie via flatpak."
  else
    echo "[$SCRIPT_NAME] Flatpak not found. Install flatpak first: sudo apt install flatpak"
  fi
else
  echo "[$SCRIPT_NAME] Whatsie already installed, skipping."
fi

# Vial - Keyboard configurator for QMK
if ! command -v vial &>/dev/null && ! dpkg -l | grep -q vial; then
  echo "[$SCRIPT_NAME] Installing Vial..."
  VIAL_VERSION=$(curl -s "https://api.github.com/repos/vial-kb/vial-gui/releases/latest" | grep -oP '"tag_name":\s*"\K[^"]*')
  if [ -z "$VIAL_VERSION" ]; then
    echo "[$SCRIPT_NAME] Failed to get Vial version"
  else
    VIAL_URL="https://github.com/vial-kb/vial-gui/releases/download/${VIAL_VERSION}/Vial-${VIAL_VERSION}-x86_64.AppImage"
    wget -q "$VIAL_URL" -O /tmp/vial.AppImage || echo "[$SCRIPT_NAME] Failed to download Vial"
    if [ -f /tmp/vial.AppImage ]; then
      chmod +x /tmp/vial.AppImage
      sudo mv /tmp/vial.AppImage /usr/local/bin/vial
      # Create desktop entry
      sudo mkdir -p /usr/share/applications
      echo -e "[Desktop Entry]\nName=Vial\nComment=QMK Keyboard Configurator\nExec=/usr/local/bin/vial\nIcon=vial\nType=Application\nCategories=Utility;Settings;\nTerminal=false" | sudo tee /usr/share/applications/vial.desktop > /dev/null
    fi
  fi
else
  echo "[$SCRIPT_NAME] Vial already installed, skipping."
fi

echo "[$SCRIPT_NAME] All extra applications processed."
