#!/usr/bin/env bash

set -euo pipefail

# Export current GNOME extension settings
EXTENSIONS_DUMP="gnome-extensions-settings.dconf"
dconf dump /org/gnome/shell/extensions/ > "$EXTENSIONS_DUMP" 2>/dev/null || true

echo "Extension settings exported to $EXTENSIONS_DUMP"

# Detect OS
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=$ID
    VERSION_ID=${VERSION_ID:-}
else
    echo "Cannot detect OS"
    exit 1
fi

# Detect GNOME shell version
GNOME_VERSION=$(gnome-shell --version 2>/dev/null | grep -oP '\d+(\.\d+)*' || echo "unknown")
echo "Detected: $OS $VERSION_ID, GNOME $GNOME_VERSION"

# Install dependencies
if [[ "$OS" == "ubuntu" || "$OS" == "debian" ]]; then
    sudo apt -y install gnome-shell-extensions gnome-tweaks || echo "Dependencies already installed or install manually"
fi

# Helper: install extension from GNOME Extensions website
install_extension() {
    local uuid=$1
    local name=$2

    echo "Installing: $name ($uuid)"

    # Check if already installed
    if [ -d "$HOME/.local/share/gnome-shell/extensions/$uuid" ]; then
        echo "  Already installed, skipping"
        return 0
    fi

    # Try to install via apt first (system extensions)
    case "$uuid" in
        "dash-to-dock@micxgx.gmail.com")
            sudo apt -y install gnome-shell-extension-dashtodock 2>/dev/null || true
            ;;
        "appindicatorsupport@rgcjonas.gmail.com")
            sudo apt -y install gnome-shell-extension-appindicator 2>/dev/null || true
            ;;
        "tiling-assistant@ubuntu.com"|"ding@rastersoft.com")
            # Ubuntu-specific, skip on Debian
            if [[ "$OS" == "ubuntu" ]]; then
                sudo apt -y install gnome-shell-extension-tiling-assistant gnome-shell-extension-desktop-icons 2>/dev/null || true
            else
                echo "  Skipping Ubuntu-specific extension: $uuid"
                return 0
            fi
            ;;
    esac

    # If not in apt, try from GNOME Extensions website
    if [ ! -d "$HOME/.local/share/gnome-shell/extensions/$uuid" ]; then
        echo "  Installing from GNOME Extensions website..."
        mkdir -p "$HOME/.local/share/gnome-shell/extensions/$uuid"

        # Fetch extension info from API
        local extension_url
        extension_url="https://extensions.gnome.org/extension-info/?uuid=$uuid&shell_version=$GNOME_VERSION"
        local ext_info
        ext_info=$(curl -fsSL --max-time 10 "$extension_url" 2>/dev/null || echo "")

        if [ -z "$ext_info" ]; then
            # Try without shell version
            extension_url="https://extensions.gnome.org/extension-info/?uuid=$uuid"
            ext_info=$(curl -fsSL --max-time 10 "$extension_url" 2>/dev/null || echo "")
        fi

        if [ -z "$ext_info" ]; then
            echo "  Failed to fetch info for $uuid, skipping"
            rm -rf "$HOME/.local/share/gnome-shell/extensions/$uuid"
            return 1
        fi

        local pk
        pk=$(echo "$ext_info" | python3 -c "import sys, json; print(json.load(sys.stdin)['pk'])" 2>/dev/null || echo "")

        if [ -z "$pk" ]; then
            echo "  No compatible version found for $uuid on GNOME $GNOME_VERSION, skipping"
            rm -rf "$HOME/.local/share/gnome-shell/extensions/$uuid"
            return 1
        fi

        # Download and extract
        local zip_url="https://extensions.gnome.org/download-extension/$uuid.shell-extension.zip?version_tag=$pk"
        local tmp_file
        tmp_file=$(mktemp)
        curl -fsSL --max-time 30 "$zip_url" -o "$tmp_file" 2>/dev/null

        if [ -f "$tmp_file" ]; then
            unzip -qo "$tmp_file" -d "$HOME/.local/share/gnome-shell/extensions/$uuid" 2>/dev/null
            rm -f "$tmp_file"
            echo "  Installed successfully"
        else
            echo "  Failed to download $uuid, skipping"
            rm -rf "$HOME/.local/share/gnome-shell/extensions/$uuid"
            rm -f "$tmp_file"
            return 1
        fi
    fi
}

# Install extensions
echo ""
echo "Installing extensions..."

install_extension "arcmenu@arcmenu.com" "ArcMenu"
install_extension "blur-my-shell@aunetx" "Blur My Shell"
install_extension "dash-to-dock@micxgx.gmail.com" "Dash to Dock"
install_extension "user-theme@gnome-shell-extensions.gcampax.github.com" "User Theme"
install_extension "appindicatorsupport@rgcjonas.gmail.com" "AppIndicator Support"
install_extension "Vitals@CoreCoding.com" "Vitals"
install_extension "focus-changer@heartmire" "Focus Changer"

# Ubuntu-specific (skip on Debian gracefully)
if [[ "$OS" == "ubuntu" ]]; then
    install_extension "ding@rastersoft.com" "Desktop Icons"
    install_extension "tiling-assistant@ubuntu.com" "Tiling Assistant"
else
    echo ""
    echo "Skipping Ubuntu-only extensions: ding, tiling-assistant"
fi

# Drive menu and workspace indicator (part of gnome-shell-extensions package)
install_extension "drive-menu@gnome-shell-extensions.gcampax.github.com" "Drive Menu"
install_extension "workspace-indicator@gnome-shell-extensions.gcampax.github.com" "Workspace Indicator"

# Enable extensions safely
echo ""
echo "Enabling extensions..."

enabled_extensions=$(dconf read /org/gnome/shell/enabled-extensions 2>/dev/null || echo "[]")

if [ -z "$enabled_extensions" ] || [ "$enabled_extensions" == "@as []" ]; then
    echo "No enabled extensions found, enabling common set..."
    gsettings set org.gnome.shell disable-user-extensions false

    # Build list of installed extensions
    installed_list="["
    for ext_dir in "$HOME/.local/share/gnome-shell/extensions"/*; do
        if [ -d "$ext_dir" ]; then
            ext_uuid=$(basename "$ext_dir")
            if [ "$installed_list" != "[" ]; then
                installed_list="$installed_list, "
            fi
            installed_list="$installed_list'$ext_uuid'"
        fi
    done
    installed_list="$installed_list]"

    if [ "$installed_list" != "[]" ]; then
        # Convert to proper array format for gsettings
        IFS=',' read -ra items <<< "$installed_list"
        formatted="["
        for item in "${items[@]}"; do
            item=$(echo "$item" | tr -d " '")
            if [ "$formatted" != "[" ]; then
                formatted="$formatted, "
            fi
            formatted="$formatted'$item'"
        done
        formatted="$formatted]"

        gsettings set org.gnome.shell enabled-extensions "$(echo "$formatted" | sed "s/'/\"/g")"
    fi
fi

# Import saved settings
echo ""
echo "Applying saved extension settings..."

if [ -f "$EXTENSIONS_DUMP" ] && [ -s "$EXTENSIONS_DUMP" ]; then
    dconf load /org/gnome/shell/extensions/ < "$EXTENSIONS_DUMP"
    echo "Settings applied successfully"
else
    echo "No settings file found, using defaults"
fi

# Clean up
rm -f "$EXTENSIONS_DUMP"

echo ""
echo "GNOME extensions setup complete. Restart GNOME Shell (Alt+F2, 'r', Enter) or log out and back in."
