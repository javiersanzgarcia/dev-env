[
  {
    "key": "ctrl+alt+b",
    "command": "workbench.action.toggleSecondarySideBarVisibility"
  },
  {
    "key": "ctrl+alt+o",
    "command": "opencode.openTerminal",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+alt+shift+o",
    "command": "opencode.openNewTerminal",
    "when": "!terminalFocus"
  }
